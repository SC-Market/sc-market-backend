        "data": {
          "alert": {
            "active": true,
            "alert_id": "alert:all_users",
            "channels": [
              "in_app",
              "push",
              "email",
            ],
            "content": "Down at 10:00",
            "created_at": "<ts>",
            "created_by": "user:admin",
            "link": "https://sc-market.space/news",
            "target_contractor_id": null,
