exports[`admin_alert (21) > all_users: everyone not banned except the admin who posted it; push mandatory, email respects opt-outs 2`] = `
{
  "discord": [],
  "discord_queue": [],
  "email": [
    {
      "html_length_bucket": 4000,
      "subject": "New admin alert: Maintenance",
      "text": "SC Market
https://sc-market.space

