            "color": 1120296,
            "fields": [
              {
                "name": "Bid Amount",
                "value": "1,500 aUEC",
              },
            ],
            "timestamp": "<ts>",
            "title": "Auctioned Gladius",
            "url": "https://sc-market.space/market/listing:v1/#/auctioned-gladius",
          },
        ],
        "username": "SC Market - Bid Received",
      },
      "method": "POST",
