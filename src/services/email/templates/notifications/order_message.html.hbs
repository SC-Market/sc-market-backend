<h1 style="color: #e8e8e8;">{{t "order_message.heading"}}</h1>

<p style="color: #b7b7b7;">{{t "common.greeting" name=userDisplayName}}</p>

<p style="color: #b7b7b7;">{{t "order_message.intro" author=message.author title=order.title}}</p>

<div
  style="background-color: rgba(45, 55, 72, 0.5); padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid rgb(45, 55, 72); border-left: 4px solid #7a7efe;"
>
  {{markdown message.content}}
</div>

<p style="text-align: center;">
  <a href="{{actionUrl}}" class="button">{{t "order_message.action"}}</a>
</p>
