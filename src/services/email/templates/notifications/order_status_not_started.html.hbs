<h1 style="color: #e8e8e8;">{{t "order_status_not_started.heading"}}</h1>

<p style="color: #b7b7b7;">{{t "common.greeting" name=userDisplayName}}</p>

<p style="color: #b7b7b7;">{{t "order_status_not_started.intro" title=order.title}}</p>

<div
  style="background-color: rgba(45, 55, 72, 0.5); padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid rgb(45, 55, 72);"
>
  <h2 style="margin-top: 0; color: #e8e8e8;">{{order.title}}</h2>
  {{#if order.description}}
    {{markdown order.description}}
  {{/if}}
  {{#if order.cost}}
    <p style="color: #b7b7b7;"><strong>{{t "common.value"}}</strong>
      {{formatCurrency order.cost}}
      aUEC</p>
  {{/if}}
  <p style="color: #b7b7b7;"><strong>{{t "common.status"}}</strong> {{t "status.order.not-started"}}</p>
</div>

<p style="text-align: center;">
  <a href="{{actionUrl}}" class="button">{{t "common.view_order"}}</a>
</p>
