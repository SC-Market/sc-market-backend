<h1 style="color: #e8e8e8;">Contractor Invitation</h1>

<p style="color: #b7b7b7;">Hello {{userDisplayName}},</p>

<p style="color: #b7b7b7;">You have been invited to join a contractor
  organization.</p>

<div
  style="background-color: rgba(45, 55, 72, 0.5); padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid rgb(45, 55, 72);"
>
  <h2 style="margin-top: 0; color: #e8e8e8;">{{contractor.name}}</h2>
  {{#if contractor.description}}
    {{markdown contractor.description}}
  {{/if}}
  {{#if invite.message}}
    <p style="color: #b7b7b7; margin: 16px 0 6px 0;"><strong>Message:</strong></p>
    {{plainText invite.message}}
  {{/if}}
</div>

<p style="text-align: center;">
  <a href="{{actionUrl}}" class="button">View Invitation</a>
</p>