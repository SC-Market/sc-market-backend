<h1 style="color: #e8e8e8;">{{t "order_review.heading"}}</h1>

<p style="color: #b7b7b7;">{{t "common.greeting" name=userDisplayName}}</p>

<p style="color: #b7b7b7;">{{t "order_review.intro"}}</p>

<div
  style="background-color: rgba(45, 55, 72, 0.5); padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid rgb(45, 55, 72);"
>
  <h2 style="margin-top: 0; color: #e8e8e8;">{{order.title}}</h2>
  <div
    style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgb(45, 55, 72);"
  >
    <p style="color: #b7b7b7; margin: 0;"><strong>{{t "common.rating"}}</strong>
      {{review.rating}}/5</p>
    {{#if review.content}}
      <div style="margin: 10px 0 0 0;">{{plainText review.content}}</div>
    {{/if}}
    {{#if review.author}}
      <p style="color: #b7b7b7; margin: 10px 0 0 0;"><strong>{{t "order_review.by"}}</strong>
        {{review.author}}</p>
    {{/if}}
  </div>
</div>

<p style="text-align: center;">
  <a href="{{actionUrl}}" class="button">{{t "common.view_order"}}</a>
</p>
