<h1 style="color: #e8e8e8;">{{t "storefront_enquiry_declined.heading"}}</h1>

<p style="color: #b7b7b7;">{{t "common.greeting" name=userDisplayName}}</p>

<p style="color: #b7b7b7;">{{t "storefront_enquiry_declined.intro"}}</p>

<div
  style="background-color: rgba(45, 55, 72, 0.5); padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid rgb(45, 55, 72);"
>
  <h2 style="margin-top: 0; color: #e8e8e8;">{{enquiry.target_name}}</h2>
  <p style="color: #b7b7b7; margin: 0;"><strong>{{t "common.subdomain"}}</strong> {{enquiry.subdomain}}</p>
</div>

<p style="color: #b7b7b7;">{{t "storefront_enquiry_declined.retry"}}</p>

<p style="text-align: center;">
  <a href="{{actionUrl}}" class="button">{{t "storefront_enquiry_declined.action"}}</a>
</p>
