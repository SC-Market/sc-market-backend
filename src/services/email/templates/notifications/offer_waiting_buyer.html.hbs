<h1 style="color: #e8e8e8;">{{offerReminder.title}}</h1>

<p style="color: #b7b7b7;">{{t "common.greeting" name=userDisplayName}}</p>

<p style="color: #b7b7b7;">{{offerReminder.body}}</p>

<div
  style="background-color: rgba(45, 55, 72, 0.5); padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid rgb(45, 55, 72);"
>
  {{#each offerReminder.offers}}
  <p style="color: #b7b7b7; margin: 0 0 8px 0;"><a href="{{this.url}}" style="color: #e8e8e8;">{{this.title}}</a> · {{this.counterparty}} · {{this.waited}}</p>
  {{/each}}
  {{#if offerReminder.more}}<p style="color: #b7b7b7; margin: 0;">{{t "common.and_more" count=offerReminder.more}}</p>{{/if}}
</div>

<p style="text-align: center;">
  <a href="{{actionUrl}}" class="button">{{t "offer_waiting_buyer.action"}}</a>
</p>
{{#if offerReminder.withdraw_url}}
<p style="color: #b7b7b7; text-align: center;">{{t "offer_waiting_buyer.withdraw_prompt" link=offerReminder.withdraw_url}} {{t "offer_waiting_buyer.keep_waiting"}}</p>
{{/if}}
