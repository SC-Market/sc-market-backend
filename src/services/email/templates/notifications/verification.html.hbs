<h1 style="color: #e8e8e8;">{{t "verification.heading"}}</h1>

<p style="color: #b7b7b7;">{{t "common.greeting" name=userDisplayName}}</p>

<p style="color: #b7b7b7;">{{t "verification.intro"}}</p>

<p style="text-align: center;">
  <a href="{{verificationUrl}}" class="button">{{t "verification.action"}}</a>
</p>

<p style="color: #b7b7b7;">{{t "verification.copy_link"}}</p>
<p style="word-break: break-all; color: #10b881;">{{verificationUrl}}</p>

<p style="color: #b7b7b7;">{{t "verification.expires"}}</p>

<p style="color: #b7b7b7;">{{t "verification.ignore"}}</p>
