<h1 style="color: #e8e8e8;">{{t "price_alert.heading"}}</h1>

<p style="color: #b7b7b7;">{{t "common.greeting" name=userDisplayName}}</p>

<p style="color: #b7b7b7;">{{t "price_alert.intro"}}</p>

<div
  style="background-color: rgba(45, 55, 72, 0.5); padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid rgb(45, 55, 72);"
>
  <h2 style="margin-top: 0; color: #e8e8e8;">{{listing.title}}</h2>
  <p style="color: #b7b7b7; margin: 0;"><strong>{{t "price_alert.price"}}</strong>
    {{formatCurrency listing.price}}
    aUEC</p>
  <p style="color: #b7b7b7; margin: 0;"><strong>{{t "price_alert.target"}}</strong>
    {{formatCurrency watch.max_price}}
    aUEC ({{watch.query}})</p>
  <p style="color: #b7b7b7; margin: 0;"><strong>{{t "price_alert.quantity"}}</strong>
    {{formatCurrency listing.quantity}}</p>
  {{#if listing.seller_name}}
    <p style="color: #b7b7b7; margin: 0;"><strong>{{t "price_alert.seller"}}</strong>
      {{listing.seller_name}}</p>
  {{/if}}
</div>

<p style="text-align: center;">
  <a href="{{actionUrl}}" class="button">{{t "common.view_listing"}}</a>
</p>
