<h1 style="color: #e8e8e8;">Price Alert</h1>

<p style="color: #b7b7b7;">Hello {{userDisplayName}},</p>

<p style="color: #b7b7b7;">A listing on your watchlist hit your target price:</p>

<div
  style="background-color: rgba(45, 55, 72, 0.5); padding: 20px; border-radius: 8px; margin: 20px 0; border: 1px solid rgb(45, 55, 72);"
>
  <h2 style="margin-top: 0; color: #e8e8e8;">{{listing.title}}</h2>
  <p style="color: #b7b7b7; margin: 0;"><strong>Price:</strong>
    {{formatCurrency listing.price}}
    aUEC</p>
  <p style="color: #b7b7b7; margin: 0;"><strong>Your target:</strong>
    {{formatCurrency watch.max_price}}
    aUEC ({{watch.query}})</p>
  <p style="color: #b7b7b7; margin: 0;"><strong>Quantity:</strong>
    {{listing.quantity}}</p>
  {{#if listing.seller_name}}
    <p style="color: #b7b7b7; margin: 0;"><strong>Seller:</strong>
      {{listing.seller_name}}</p>
  {{/if}}
</div>

<p style="text-align: center;">
  <a href="{{actionUrl}}" class="button">View Listing</a>
</p>
