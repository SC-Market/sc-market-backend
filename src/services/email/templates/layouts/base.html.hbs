<html lang="{{lang}}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{notificationTitle}}</title>
    <style>
      body {
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Helvetica,
          Arial,
          "Hiragino Sans",
          "PingFang SC",
          "PingFang TC",
          "Microsoft YaHei",
          "Microsoft JhengHei",
          "Noto Sans CJK JP",
          sans-serif;
        line-height: 1.6;
        color: #b7b7b7;
        background-color: #0b0f1a;
        margin: 0;
        padding: 0;
      }
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #111828;
        border: 1px solid rgb(45, 55, 72);
      }
      .email-header {
        background: linear-gradient(135deg, #10b881 0%, #7a7efe 100%);
        padding: 20px 30px;
        display: flex;
        align-items: center;
      }
      .email-header img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: contain;
        display: block;
        background-color: #111828;
        padding: 4px;
      }
      .email-header h1 {
        color: #ffffff;
        margin: 0 0 0 16px;
      }
      .email-body {
        padding: 40px 30px;
        color: #b7b7b7;
        overflow-wrap: break-word;
      }
      .email-body h1,
      .email-body h2,
      .email-body h3 {
        color: #e8e8e8;
      }
      .email-footer {
        background-color: #111828;
        padding: 30px;
        text-align: center;
        font-size: 12px;
        color: #929ca1;
        border-top: 1px solid rgb(45, 55, 72);
      }
      .button {
        display: inline-block;
        max-width: 100%;
        box-sizing: border-box;
        padding: 12px 24px;
        background-color: #10b881;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 8px;
        margin: 20px 0;
        font-weight: 600;
      }
      .button:hover {
        background-color: #0ea371;
      }
      .unsubscribe-link {
        color: #929ca1;
        text-decoration: none;
        font-size: 12px;
      }
      .unsubscribe-link:hover {
        color: #b7b7b7;
        text-decoration: underline;
      }
      @media only screen and (max-width: 600px) {
        .email-body {
          padding: 20px 15px;
        }
        .button {
          display: block;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    {{#if preheader}}
    <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #0b0f1a; opacity: 0;">{{preheader}}</div>
    {{/if}}
    <div class="email-container">
      <div class="email-header">
        {{#if logoUrl}}
          <img src="{{logoUrl}}" alt="{{siteName}}" />
        {{/if}}
        <h1>{{siteName}}</h1>
      </div>
      {{#if defaultsNotice}}
      <div style="background-color: #1f2a30; border-left: 4px solid #10b981; padding: 14px 20px; color: #e0e0e0; font-size: 14px;">
        {{t "layout.defaults_notice"}}
        <a href="{{defaultsNotice.unsubscribeUrl}}" style="color: #10b981;">{{t "layout.turn_off"}}</a>
        |
        <a href="{{defaultsNotice.preferencesUrl}}" style="color: #10b981;">{{t "layout.manage_preferences"}}</a>
      </div>
      {{/if}}
      <div class="email-body">
        {{{body}}}
      </div>
      <div class="email-footer">
        <p style="margin: 0 0 10px 0;">
          <a href="{{siteUrl}}" class="unsubscribe-link">{{siteName}}</a>
        </p>
        <p style="margin: 0;">
          {{#if unsubscribeUrl}}
          <a href="{{unsubscribeUrl}}" class="unsubscribe-link">{{t "layout.unsubscribe"}}</a>
          |
          {{/if}}
          <a href="{{preferencesUrl}}" class="unsubscribe-link">{{t "layout.manage_preferences"}}</a>
        </p>
      </div>
    </div>
  </body>
</html>